    btn.AutoButtonColor = false
    btn.LayoutOrder = SlotOrderCounter
    btn.Parent = ToolContainer

    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(120, 70, 110)
    stroke.Transparency = 0.3

    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon"
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.new(0, 34, 0, 34)
    icon.Position = UDim2.new(0.5, -17, 0.5, -17)
    icon.Image = tool.TextureId ~= "" and tool.TextureId or ""
    icon.Visible = tool.TextureId ~= ""
