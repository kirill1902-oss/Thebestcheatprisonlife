local function buildFOVSlider()
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 6); lbl.Size = UDim2.new(0, 100, 0, 14)
    lbl.Font = Enum.Font.GothamMedium
    lbl.Text = "FOV: " .. State.FOV; lbl.TextColor3 = Theme.TextDim
    lbl.TextSize = 10; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = FOVContainer

    local track = Instance.new("Frame")
    track.BackgroundColor3 = Color3.fromRGB(55, 30, 55); track.BorderSizePixel = 0
    track.Position = UDim2.new(0, 110, 0, 10); track.Size = UDim2.new(1, -126, 0, 8)
    track.Parent = FOVContainer
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Theme.Accent; fill.BorderSizePixel = 0
    fill.Size = UDim2.new(State.FOV / 500, 0, 1, 0); fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = Theme.Text
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(fill.Size.X.Scale, -7, 0.5, -7)
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        State.FOV = math.floor(rel * 500)
        lbl.Text = "FOV: " .. State.FOV
    end)
end

