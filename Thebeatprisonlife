--// ДИСТАНЦИЯ ДО ЦЕЛИ
local function getMyHrp()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function isWithinAimRange(part)
    if not part then return false end
    local myHrp = getMyHrp()
    if not myHrp then return false end
    return (part.Position - myHrp.Position).Magnitude <= MAX_AIM_DISTANCE
end

--// TARGET FINDERS
function findClosestEnemy()
    if not (State.Aim or State.Trigger) then return nil, nil end
    local myHrp = getMyHrp()
    if not myHrp then return nil, nil end

    local sc = Camera.ViewportSize * 0.5
    local cl, cd, cp = nil, State.FOV, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if isAimTarget(p) then
            local char = p.Character; local hrp = CharacterCache[p]
            if char and hrp then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist <= MAX_AIM_DISTANCE then
                        local aimPart = char:FindFirstChild("Head") or hrp
                        local sp, on = Camera:WorldToViewportPoint(aimPart.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                            if d < cd then cl, cd, cp = p, d, aimPart end
                        end
                    end
                end
            end
        end
    end
    if cp and not isVisible(cp) then return nil, nil end
    return cl, cp
end

function findClosestAll()
    if not State.AimAssist then return nil, nil end
    local myHrp = getMyHrp()
    if not myHrp then return nil, nil end

    local sc = Camera.ViewportSize * 0.5
    local cl, cd, cp = nil, State.FOV, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character; local hrp = CharacterCache[p]
            if char and hrp then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist <= MAX_AIM_DISTANCE then
                        local aimPart = char:FindFirstChild("Head") or hrp
                        local sp, on = Camera:WorldToViewportPoint(aimPart.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                            if d < cd then cl, cd, cp = p, d, aimPart end
                        end
                    end
                end
            end
        end
    end
    if cp and not isVisible(cp) then return nil, nil end
    return cl, cp
end

