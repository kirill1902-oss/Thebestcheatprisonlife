--// HITBOX
local function resetHitboxOnCharacter(char)
    if not char then return end
    local list = HitboxCache[char]
    if list then
        for _, e in ipairs(list) do
            if e.conn then e.conn:Disconnect() end
            if e.hb then
                unregisterHitbox(e.hb)
                if e.hb.Parent then e.hb:Destroy() end
            end
        end
        HitboxCache[char] = nil
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part.Name == "PL_Hitbox" then
            unregisterHitbox(part); part:Destroy()
        end
    end
end

local function applyHitboxToCharacter(char)
    if not char or HitboxCache[char] then return end
    local list = {}
    for partName in pairs(HitboxParts) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") and not part:FindFirstChild("PL_Hitbox") then
            local hb = Instance.new("Part")
            hb.Name = "PL_Hitbox"; hb.Size = part.Size * HITBOX_SCALE
            hb.Transparency = 0.75; hb.Color = Color3.fromRGB(255, 130, 180)
            hb.Material = Enum.Material.Neon
            hb.CanCollide = true; hb.CanTouch = true; hb.CanQuery = true
            hb.Massless = true; hb.Anchored = false; hb.CastShadow = false
            hb.CFrame = part.CFrame; hb.Parent = char
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = part; weld.Part1 = hb; weld.Parent = hb
            local conn = part:GetPropertyChangedSignal("Size"):Connect(function()
                if hb and hb.Parent then hb.Size = part.Size * HITBOX_SCALE end
            end)
            registerHitbox(hb)
            table.insert(list, {hb = hb, conn = conn})
        end
    end
    HitboxCache[char] = list
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Died:Connect(function() resetHitboxOnCharacter(char) end) end
end

local function enableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then applyHitboxToCharacter(p.Character) end
    end
end

local function disableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then resetHitboxOnCharacter(p.Character) end
    end
end

