--// FACTION
local function getTeamKind(player)
    local t = player.Team
    if not t then return "Neutral" end
    local n = string.lower(t.Name)
    if n:find("guard") or n:find("police") or n:find("warden")
    or n:find("cop") or n:find("officer") or n:find("sheriff") then return "Guard" end
    if n:find("crim") or n:find("escape") or n:find("fugitive") then return "Criminal" end
    if n:find("inmate") or n:find("prisoner") or n:find("convict") then return "Inmate" end
    return "Neutral"
end

local function isAimTarget(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local my, his = getTeamKind(LocalPlayer), getTeamKind(player)
    if my == "Neutral" then return his ~= "Neutral" or player.Team ~= LocalPlayer.Team end
    if my == "Guard" then return his == "Criminal" end
    if my == "Criminal" then return his == "Guard" end
    if my == "Inmate" then return his == "Guard" or his == "Criminal" end
    return player.Team ~= LocalPlayer.Team
end

local function isFactionEnemy(p) return isAimTarget(p) end

--// RAYCAST
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local function buildIgnoreList(targetPart)
    local list = { LocalPlayer.Character }
    local tChar = targetPart and targetPart:FindFirstAncestorOfClass("Model")
    if tChar then table.insert(list, tChar) end
    for part in pairs(ActiveHitboxes) do
        if part.Parent then table.insert(list, part) end
    end
    return list
end

local function isVisible(targetPart)
    if not targetPart or not LocalPlayer.Character then return false end
    RayParams.FilterDescendantsInstances = buildIgnoreList(targetPart)
    local origin = Camera.CFrame.Position
    local dir    = targetPart.Position - origin
    return workspace:Raycast(origin, dir, RayParams) == nil
end

