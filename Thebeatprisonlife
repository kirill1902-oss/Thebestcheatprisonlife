local SlotCache = {}
local SlotOrderCounter = 0

local function updateSlotVisual(btn, tool)
    local char = LocalPlayer.Character
    local equipped = char and char:FindFirstChildOfClass("Tool")
    local stroke = btn:FindFirstChildOfClass("UIStroke")
    if not stroke then return end
    if equipped == tool then
        stroke.Color = Color3.fromRGB(180, 240, 190)
        stroke.Transparency = 0
        btn.BackgroundColor3 = Color3.fromRGB(60, 30, 60)
    else
        stroke.Color = Color3.fromRGB(120, 70, 110)
        stroke.Transparency = 0.3
        btn.BackgroundColor3 = Color3.fromRGB(38, 18, 38)
    end
end

local function refreshAllSlots()
    for t, data in pairs(SlotCache) do
        if data.button and data.button.Parent then
            updateSlotVisual(data.button, t)
        end
    end
end

local function createSlot(tool)
    if not tool or not tool.Parent then return end
    if SlotCache[tool] then return end

    SlotOrderCounter += 1

    local btn = Instance.new("TextButton")
    btn.Name = "Slot_" .. tool.Name
    btn.Size = UDim2.new(0, 48, 0, 48)
