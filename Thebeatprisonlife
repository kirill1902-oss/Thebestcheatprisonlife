    label.TextColor3 = Color3.fromRGB(255, 220, 240)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(30, 10, 30)
    label.TextSize = 14
    label.Visible = true
    label.Parent = btn

    --// Клик — экипировать / снять
    btn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local current = char:FindFirstChildOfClass("Tool")
        if current == tool then
            hum:UnequipTools()
        else
            if tool.Parent and tool.Parent:IsA("Backpack") then
                tool.Parent = char
            end
            hum:EquipTool(tool)
        end
        task.wait()
        refreshAllSlots()
    end)

    SlotCache[tool] = { button = btn }
    task.wait()
    updateHotbarSize()
    updateSlotVisual(btn, tool)
end

local function removeSlot(tool)
    if SlotCache[tool] then
        SlotCache[tool].button:Destroy()
        SlotCache[tool] = nil
        task.wait()
        updateHotbarSize()
    end
end

