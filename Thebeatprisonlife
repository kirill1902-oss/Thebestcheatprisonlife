--// MAIN LOOP
RunService.RenderStepped:Connect(function()
    local now = os.clock()

    local showFOV = State.Aim or State.Trigger or State.AimAssist
    if FOVCircle.Visible ~= showFOV then FOVCircle.Visible = showFOV end
    if showFOV then
        FOVCircle.Position = Camera.ViewportSize * 0.5
        FOVCircle.Radius   = State.FOV
    end

    if State.Hitbox and now - lastHitboxScan > HITBOX_SCAN_INTERVAL then
        lastHitboxScan = now
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                if char and not HitboxCache[char] then
                    applyHitboxToCharacter(char)
                end
            end
        end
    end

    local aimed, target, part = false, nil, nil

    if State.AimAssist then
        if now - lastAimUpdate > AIM_UPDATE_INTERVAL then
            TargetCache.player, TargetCache.part = findClosestAll()
            lastAimUpdate = now
        end
        target, part = TargetCache.player, TargetCache.part
        if target and part then
            aimed = true
            if Camera.CameraType ~= Enum.CameraType.Custom then
                Camera.CameraType = Enum.CameraType.Custom
            end
            local cp = Camera.CFrame.Position
            if (cp - part.Position).Magnitude > 0.5 then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(cp, part.Position), AIM_SPEED)
            end
        end
    end

    if not aimed and (State.Aim or State.Trigger) then
        if hasToolEquipped() then
            if now - lastAimUpdate > AIM_UPDATE_INTERVAL then
                TargetCache.player, TargetCache.part = findClosestEnemy()
                lastAimUpdate = now
            end
            target, part = TargetCache.player, TargetCache.part
            if target and part then
                aimed = true
                if State.Aim then
                    if Camera.CameraType ~= Enum.CameraType.Custom then
                        Camera.CameraType = Enum.CameraType.Custom
                    end
                    local cp = Camera.CFrame.Position
                    if (cp - part.Position).Magnitude > 0.5 then
                        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(cp, part.Position), AIM_SPEED)
                    end
                end
                if State.Trigger and now - lastTrigger > nextTriggerDelay then
                    local char = LocalPlayer.Character
                    local tool = char and char:FindFirstChildOfClass("Tool")
                    if tool and isVisible(part) and isWithinAimRange(part) then
                        local camLook = Camera.CFrame.LookVector
                        local toT = (part.Position - Camera.CFrame.Position).Unit
                        local ang = math.deg(math.acos(math.clamp(camLook:Dot(toT), -1, 1)))
                        if ang <= MAX_AIM_ANGLE then
                            lastTrigger = now
                            nextTriggerDelay = TriggerCooldownMin + math.random() * (TriggerCooldownMax - TriggerCooldownMin)
                            local sp, on = Camera:WorldToViewportPoint(part.Position)
                            if on then
                                pcall(function()
                                    VirtualUser:Button1Down(Vector2.new(sp.X, sp.Y))
                                    task.wait(0.03 + math.random() * 0.04)
                                    VirtualUser:Button1Up(Vector2.new(sp.X, sp.Y))
                                end)
                            end
                        end
                    end
                end
            end
        else
            TargetCache.player, TargetCache.part = nil, nil
        end
    end

    if LastTeamName ~= (LocalPlayer.Team and LocalPlayer.Team.Name) then
        LastTeamName = LocalPlayer.Team and LocalPlayer.Team.Name
        updateTeamBadge()
    end
end)

