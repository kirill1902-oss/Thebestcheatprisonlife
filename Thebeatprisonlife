--// DRAG ВСЕЙ ПАНЕЛИ
do
    local dragging, dragStart, startPos = false, nil, nil

    local function beginDrag(input)
        if _G.PL_HotbarLocked then
            showHint("🔒 Хотбар зафиксирован — снимите замок", Theme.Red)
            return
        end
        dragging = true
        dragStart = input.Position
        startPos  = HotbarRoot.Position
        showHint("🖐️ Двигай хотбар...", Theme.Accent)
    end

    local function processDrag(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = input.Position - dragStart
        HotbarRoot.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end

    local function endDrag()
        if dragging then
            dragging = false
            _G.PL_HotbarPos = HotbarRoot.Position
        end
    end

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then endDrag() end
            end)
        end
    end)
    TopBar.InputChanged:Connect(processDrag)

    ToolContainer.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then endDrag() end
            end)
        end
    end)
    ToolContainer.InputChanged:Connect(processDrag)
end

